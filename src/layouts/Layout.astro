---
const { title = "Public Sphere Lab | KAIST" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>

	<body>
		<header>
			<a href={base} class="logo">Public Sphere Lab</a>

			<nav>
				<a href={base}>Home</a>
				<a href={`${base}about`}>About</a>
				<a href={`${base}people`}>People</a>
				<a href={`${base}research`}>Research</a>
				<a href={`${base}publications`}>Publications</a>
				<a href={`${base}news`}>News</a>
				<a href={`${base}contact`}>Contact</a>
			</nav>
		</header>

		<slot />

		<footer>
			<div>
				<p class="footer-logo">Public Sphere Lab</p>
				<p>KAIST</p>
			</div>

			<div>
				<p>Communication, Technology,</p>
				<p>and the Public Sphere</p>
			</div>

			<div>
				<a href={`${base}contact`}>Contact</a>
				<p>© 2026 Public Sphere Lab</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		margin: 0;
		padding: 0;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		padding: 0;
		font-family: Arial, Helvetica, sans-serif;
		color: #111;
		background: #fff;
	}

	:global(a) {
		color: inherit;
	}

	header {
		height: 90px;
		padding: 0 6vw;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #ddd;
		background: #fff;
	}

	.logo {
		font-size: 22px;
		font-weight: 700;
		text-decoration: none;
		color: #111;
	}

	nav {
		display: flex;
		gap: 30px;
	}

	nav a {
		font-size: 15px;
		text-decoration: none;
		color: #111;
	}

	nav a:hover,
	.logo:hover {
		opacity: 0.55;
	}

	footer {
		background: #f1f1f1;
		padding: 70px 6vw;
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 40px;
		font-size: 14px;
		line-height: 1.5;
	}

	footer p {
		margin: 0 0 5px;
	}

	.footer-logo {
		font-size: 22px;
		font-weight: 700;
		margin-bottom: 15px;
	}

	footer div:last-child {
		text-align: right;
	}

	footer a {
		display: inline-block;
		margin-bottom: 18px;
	}

	@media (max-width: 900px) {
		header {
			height: auto;
			padding-top: 25px;
			padding-bottom: 25px;
			align-items: flex-start;
			gap: 30px;
		}

		nav {
			flex-wrap: wrap;
			justify-content: flex-end;
			gap: 12px 20px;
		}

		footer {
			grid-template-columns: 1fr;
		}

		footer div:last-child {
			text-align: left;
		}
	}

	@media (max-width: 600px) {
		header {
			display: block;
		}

		nav {
			margin-top: 22px;
			justify-content: flex-start;
		}

		nav a {
			font-size: 14px;
		}
	}
</style>