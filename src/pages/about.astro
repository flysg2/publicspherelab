---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Public Sphere Lab">
	<main>
		<section class="about-hero">
			<p class="eyebrow">ABOUT</p>

			<h1>
				Communication,<br />
				Technology,<br />
				and the Public Sphere.
			</h1>
		</section>

		<section class="about-intro">
			<p>
				Public Sphere Lab studies communication at the intersection
				of media, technology, and democracy. We examine how people
				encounter different perspectives, form judgments about public
				issues, and engage with others across social and political
				divides. Our research spans political communication,
				deliberation, intergroup communication, emerging technologies,
				and public perceptions of science and artificial intelligence.
			</p>
		</section>
	</main>
</Layout>

<style>
	.about-hero {
		padding: 12vh 6vw 10vh;
		border-bottom: 1px solid #ddd;
	}

	.eyebrow {
		font-size: 14px;
		letter-spacing: 0.12em;
		margin: 0 0 40px;
	}

	h1 {
		font-size: clamp(64px, 7vw, 110px);
		line-height: 1.10;
		letter-spacing: -0.05em;
		margin: 0;
		max-width: 1200px;
	}

	.about-intro {
		padding: 90px 6vw 110px;
		border-bottom: 1px solid #ddd;
	}

	.about-intro p {
		font-size: clamp(22px, 2vw, 30px);
		line-height: 1.6;
		max-width: 1100px;
		margin: 0;
	}

	@media (max-width: 900px) {
		.about-hero {
			padding: 10vh 6vw 8vh;
		}

		.about-intro {
			padding: 70px 6vw 80px;
		}
	}

	@media (max-width: 600px) {
		h1 {
			font-size: 52px;
		}

		.about-intro p {
			font-size: 20px;
		}
	}
</style>