---
import Layout from "../layouts/Layout.astro";
import { publications } from "../data/publications.js";

const years = [...new Set(publications.map((item) => item.year))]
	.sort((a, b) => b - a);
---

<Layout title="Publications | Public Sphere Lab">
	<main>

		<section class="publications-hero">
			<h1>Publications</h1>

			<p class="intro">
				Research on political communication, deliberation,
				intergroup communication, media psychology, news and
				misinformation, science and risk communication, and
				artificial intelligence.
			</p>
		</section>

		<section class="publication-list">
			{
				years.map((year) => (
					<section class="year-group">

						<h2 class="year">{year}</h2>

						<div class="year-publications">
							{
								publications
									.filter((item) => item.year === year)
									.map((item) => (
										<article class="publication">

											<h3>{item.title}</h3>

											<p class="authors">
												{item.authors}
											</p>

											<p class="venue">
												{item.venue}
											</p>

										</article>
									))
							}
						</div>

					</section>
				))
			}
		</section>

	</main>
</Layout>

<style>
	.publications-hero {
		padding: 12vh 6vw 10vh;
		border-bottom: 1px solid #ddd;
	}

	.publications-hero h1 {
		font-size: clamp(64px, 7vw, 110px);
		line-height: 1.1;
		letter-spacing: -0.05em;
		margin: 0 0 45px;
	}

	.intro {
		font-size: clamp(22px, 2vw, 30px);
		line-height: 1.55;
		max-width: 950px;
		margin: 0;
	}

	.publication-list {
		padding: 0 6vw;
	}

	.year-group {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 55px;
		padding: 65px 0;
		border-bottom: 1px solid #bbb;
	}

	.year {
		font-size: 22px;
		font-weight: 500;
		margin: 4px 0 0;
	}

	.year-publications {
		max-width: 1050px;
	}

	.publication {
		padding-bottom: 38px;
		margin-bottom: 38px;
		border-bottom: 1px solid #ddd;
	}

	.publication:last-child {
		margin-bottom: 0;
		padding-bottom: 0;
		border-bottom: none;
	}

	.publication h3 {
		font-size: clamp(21px, 2vw, 30px);
		line-height: 1.35;
		letter-spacing: -0.015em;
		margin: 0 0 13px;
	}

	.authors {
		font-size: 16px;
		line-height: 1.55;
		margin: 0 0 7px;
		color: #333;
	}

	.venue {
		font-size: 15px;
		line-height: 1.5;
		color: #666;
		margin: 0;
	}

	@media (max-width: 800px) {
		.year-group {
			grid-template-columns: 1fr;
			gap: 30px;
		}
	}

	@media (max-width: 600px) {
		.publications-hero {
			padding: 8vh 6vw;
		}

		.publications-hero h1 {
			font-size: 52px;
			margin-bottom: 30px;
		}

		.intro {
			font-size: 20px;
		}

		.year-group {
			padding: 50px 0;
		}

		.year {
			font-size: 20px;
		}

		.publication {
			padding-bottom: 30px;
			margin-bottom: 30px;
		}

		.publication h3 {
			font-size: 22px;
		}

		.authors {
			font-size: 15px;
		}

		.venue {
			font-size: 14px;
		}
	}
</style>