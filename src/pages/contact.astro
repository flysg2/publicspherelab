---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Public Sphere Lab">
	<main>
		<section class="contact-hero">
			<h1>Contact</h1>

			<p class="intro">
				For research inquiries, collaboration, and information about
				Public Sphere Lab, please contact us using the information below.
			</p>
		</section>

		<section class="contact-section">
			<div class="contact-block">
				<p class="label">EMAIL</p>
				<p class="contact-main">
					lab-email@kaist.ac.kr
				</p>
			</div>

			<div class="contact-block">
				<p class="label">AFFILIATION</p>
				<p class="contact-main">
					Public Sphere Lab<br />
					KAIST
				</p>
			</div>

			<div class="contact-block">
				<p class="label">LOCATION</p>
				<p class="contact-main">
					Daejeon, Republic of Korea
				</p>
			</div>
		</section>
	</main>
</Layout>

<style>
	.contact-hero {
		padding: 12vh 6vw 10vh;
		border-bottom: 1px solid #ddd;
	}

	.contact-hero h1 {
		font-size: clamp(64px, 7vw, 110px);
		line-height: 1.1;
		letter-spacing: -0.05em;
		margin: 0 0 45px;
	}

	.intro {
		font-size: clamp(22px, 2vw, 30px);
		line-height: 1.55;
		max-width: 900px;
		margin: 0;
	}

	.contact-section {
		padding: 0 6vw;
	}

	.contact-block {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		gap: 50px;
		padding: 55px 0;
		border-bottom: 1px solid #ddd;
	}

	.label {
		font-size: 13px;
		letter-spacing: 0.1em;
		margin: 7px 0 0;
	}

	.contact-main {
		font-size: clamp(24px, 2.5vw, 36px);
		line-height: 1.45;
		margin: 0;
		max-width: 800px;
	}

	@media (max-width: 700px) {
		.contact-hero {
			padding: 8vh 6vw;
		}

		.contact-hero h1 {
			font-size: 52px;
			margin-bottom: 30px;
		}

		.intro {
			font-size: 20px;
		}

		.contact-block {
			grid-template-columns: 1fr;
			gap: 15px;
			padding: 40px 0;
		}

		.contact-main {
			font-size: 24px;
		}
	}
</style>