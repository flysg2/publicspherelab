---
import Layout from "../layouts/Layout.astro";
import { news } from "../data/news.js";
---

<Layout title="News | Public Sphere Lab">
	<main>
		<section class="news-hero">
			<h1>News</h1>

			<p class="intro">
				Updates on research, publications, presentations,
				events, and activities from Public Sphere Lab.
			</p>
		</section>

		<section class="news-list">
			{
				news.map((item) => (
					<article class="news-item">
						<p class="date">{item.date}</p>

						<div class="news-content">
							<h2>
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									{item.title}
								</a>
							</h2>

							{
								item.description && (
									<p>{item.description}</p>
								)
							}
						</div>
					</article>
				))
			}
		</section>
	</main>
</Layout>

<style>
	.news-hero {
		padding: 12vh 6vw 10vh;
		border-bottom: 1px solid #ddd;
	}

	.news-hero h1 {
		font-size: clamp(64px, 7vw, 110px);
		line-height: 1.1;
		letter-spacing: -0.05em;
		margin: 0 0 45px;
	}

	.intro {
		font-size: clamp(22px, 2vw, 30px);
		line-height: 1.55;
		max-width: 900px;
		margin: 0;
	}

	.news-list {
		padding: 0 6vw;
	}

	.news-item {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 55px;
		padding: 55px 0;
		border-bottom: 1px solid #ddd;
	}

	.date {
		font-size: 16px;
		margin: 5px 0 0;
	}

	.news-content {
		max-width: 900px;
	}

	.news-content h2 {
		font-size: clamp(26px, 2.8vw, 40px);
		line-height: 1.25;
		letter-spacing: -0.025em;
		margin: 0 0 18px;
	}

	.news-content h2 a {
		color: inherit;
		text-decoration: none;
	}

	.news-content h2 a:hover {
		opacity: 0.55;
	}

	.news-content p {
		font-size: 17px;
		line-height: 1.7;
		max-width: 760px;
		margin: 0;
		color: #444;
	}

	@media (max-width: 700px) {
		.news-item {
			grid-template-columns: 1fr;
			gap: 15px;
		}

		.news-hero {
			padding: 8vh 6vw;
		}

		.news-hero h1 {
			font-size: 52px;
			margin-bottom: 30px;
		}

		.intro {
			font-size: 20px;
		}
	}
</style>